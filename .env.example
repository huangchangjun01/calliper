# ============================================
# 量化交易系统环境变量配置
# ============================================

# --- 应用 ---
APP_ENV=development
APP_NAME=quant-trading
LOG_LEVEL=debug

# --- PostgreSQL (业务数据库) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=quant
DB_PASSWORD=quant123
DB_NAME=quant_trading

# --- TimescaleDB (时序数据库) ---
TSDB_HOST=localhost
TSDB_PORT=5433
TSDB_USER=quant
TSDB_PASSWORD=quant123
TSDB_NAME=quant_tsdb

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka ---
KAFKA_BROKERS=localhost:9092

# --- MinIO (对象存储) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false

# --- ML 服务 ---
ML_SERVICE_URL=http://localhost:8000

# --- 前端 ---
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=24

# --- 第三方 API ---
TUSHARE_TOKEN=
AKSHARE_DATA_DIR=./data