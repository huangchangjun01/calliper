# ============================================
# 量化交易系统环境变量配置
# ============================================

# --- 应用 ---
APP_ENV=development
APP_NAME=quant-trading
LOG_LEVEL=debug

# --- 交易开关 ---
REAL_TRADING_ENABLED=false

# --- CORS 允许来源（逗号分隔） ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- PostgreSQL (业务数据库) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=calliper
DB_PASSWORD=change-me-in-production
DB_NAME=calliper_trading

# --- TimescaleDB (时序数据库) ---
TSDB_HOST=localhost
TSDB_PORT=5433
TSDB_USER=calliper
TSDB_PASSWORD=change-me-in-production
TSDB_NAME=calliper_tsdb

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka ---
KAFKA_BROKERS=localhost:9092

# --- MinIO (对象存储) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false

# --- ML 服务 ---
ML_SERVICE_URL=http://localhost:8000
# 必配：backend 与 ml-service 之间的共享密钥（未配置时 ml-service 不做鉴权）
ML_API_KEY=change-me-in-production

# --- 前端 ---
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=24

# --- 第三方 API ---
TUSHARE_TOKEN=
AKSHARE_DATA_DIR=./data